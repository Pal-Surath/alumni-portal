# ==========================================
# ALUMNI PORTAL - GIT IGNORE
# ==========================================

# Environment / secrets
.env
.env.*
!.env.example

# Database credentials / local configuration
config.local.php

# Logs
*.log
logs/
error_log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp
*.bak
*.old

# PHP temporary/session files
*.sess

# Uploaded profile images
assets/images/profiles/*

# Keep the profile images folder itself
!assets/images/profiles/.gitkeep

# Local XAMPP / development files
xampp/
htdocs/

# Node.js files (if ever used)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Composer files generated locally
/vendor/

# Python cache (if any tools are used)
__pycache__/
*.pyc

